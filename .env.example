# Optional helper for Shopify CLI config linking.
# PowerShell:
#   $env:SHOPIFY_FLAG_CLIENT_ID="your-shopify-client-id"
#   shopify app config link --client-id $env:SHOPIFY_FLAG_CLIENT_ID
#
# Bash:
#   export SHOPIFY_FLAG_CLIENT_ID="your-shopify-client-id"
#   shopify app config link --client-id "$SHOPIFY_FLAG_CLIENT_ID"

SHOPIFY_FLAG_CLIENT_ID=your-shopify-client-id
